PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=change_this_secret
# Optional: AI-powered chat suggestions via OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the OpenRouter model used for suggestions
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: AI rate limit (protects the OpenRouter quota from typing bursts).
# Leave these as-is unless you want to tune the limits.
# AI_RATE_WINDOW_MS=60000
# AI_RATE_MAX=30
# AI_RATE_MIN_GAP_MS=700

# --- Media sharing (AWS S3) ---
# Create an IAM user + bucket by following README.md. Never put real keys here.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# --- Chat archiving (cron) ---
# Archive messages older than this many hours (default 24)
ARCHIVE_AFTER_HOURS=24
# Cron schedule for the archive job (default: every hour at :00)
ARCHIVE_CRON=0 * * * *

# --- CORS ---
# Comma separated allowed origins. "*" for local development.
CLIENT_ORIGIN=*
# Set false when your hosting provider runs archive as a separate cron job.
ENABLE_INTERNAL_ARCHIVE_CRON=true
