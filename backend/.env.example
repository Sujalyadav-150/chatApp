PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=change_this_secret
# Public URL of the frontend, without a trailing slash.
# Local development: http://localhost:3000
# Production: set this in hosting environment variables to your deployed frontend URL.
CLIENT_URL=http://localhost:3000

# Password reset email delivery (SMTP). Never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com

# Optional: AI-powered chat suggestions via OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# AI_RATE_WINDOW_MS=60000
# AI_RATE_MAX=30
# AI_RATE_MIN_GAP_MS=700

# --- Media sharing (AWS S3) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
MAX_UPLOAD_BYTES=26214400

# --- Chat archiving (cron) ---
ARCHIVE_AFTER_HOURS=24
ARCHIVE_CRON=0 * * * *

# --- CORS ---
CLIENT_ORIGIN=*
ENABLE_INTERNAL_ARCHIVE_CRON=true
